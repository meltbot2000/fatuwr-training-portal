# Workout-log service — copy to .env for local dev.

# This app's OWN MySQL database (not the portal's). On Railway: add a MySQL service and
# set this to ${{MySQL.MYSQL_URL}}.
DATABASE_URL=mysql://root:password@localhost:3306/workout_log

# Portal base URL and the shared partner-API key (same value as the portal's
# WORKOUT_LOG_API_KEY). Server-to-server only — never sent to the browser.
PORTAL_URL=https://fatuwr.up.railway.app
PORTAL_API_KEY=

# Signs login tokens. Any long random string: openssl rand -hex 32
SESSION_SECRET=

# Minutes between automatic training syncs (default 30).
SYNC_INTERVAL_MINUTES=30
PORT=3100

# URL prefix when served via the portal's /amager forward. Empty = served at the root.
BASE_PATH=/amager
